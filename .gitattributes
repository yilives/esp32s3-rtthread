# Normalise line endings. The sources are written with LF; checking out with
# CRLF on Windows is fine for the C files, but the patches must survive
# byte-for-byte or `git apply` rejects them.
* text=auto

*.patch  text eol=lf
*.sh     text eol=lf
*.c      text eol=lf
*.h      text eol=lf
*.S      text eol=lf
*.ld     text eol=lf
*.lds    text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.csv    text eol=lf
*.ps1    text eol=crlf