# RT-Thread building script for the Xtensa architecture port

import os
from building import *

cwd = GetCurrentDir()
CPPPATH = [cwd]

src = [
    'cpuport.c',
    'backtrace.c',
]

if rtconfig.PLATFORM in ['gcc']:
    src += ['context_gcc.S']

group = DefineGroup('CPU', src, depend = [''], CPPPATH = CPPPATH)

Return('group')
